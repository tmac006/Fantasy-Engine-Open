# Copy to .env and fill in. Never commit .env.

# Postgres connection. Leave empty to use the embedded dev server (pgserver),
# which stores data in ./.pgdata — zero setup, real Postgres 16.
# With Docker: postgresql+psycopg://fantasy:fantasy@localhost:5432/fantasy
DATABASE_URL=

LOG_LEVEL=INFO

# Optional: only needed so in-season jobs can read PRIVATE ESPN leagues.
# Copy from your browser cookies for fantasy.espn.com (SWID includes braces).
ESPN_S2=
ESPN_SWID=

# Phase 2+: Odds API key (free tier) — https://the-odds-api.com
ODDS_API_KEY=
